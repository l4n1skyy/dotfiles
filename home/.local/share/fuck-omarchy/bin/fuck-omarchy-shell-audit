#!/bin/bash

# fuck-omarchy:summary=Check how modular the active shell profile is: cross-plugin imports, hard-coded plugin ids, kit usage
# fuck-omarchy:args=[--strict] [profile]
# fuck-omarchy:examples=fuck-omarchy shell-audit | fuck-omarchy shell-audit --strict

# The rules a plugin follows so it can be swapped on its own:
#   1. no imports or relative paths into another plugin's folder
#   2. other plugins are reached by capability name (summon("osd"),
#      firstPartyServiceFor("notifications")), declared in its manifest under
#      fuck_omarchy.uses, not by hard-coded plugin id
#   3. shared look and widgets come only from the kit (qs.Commons, qs.Ui);
#      a plugin that imports neither is "kit-free" and runs in any profile
#
# Prints one row per plugin. --strict exits 1 if rule 1 or 2 is broken.

strict=0
profile=""
for arg in "$@"; do
  case "$arg" in
    --strict) strict=1 ;;
    -h|--help) sed -n 's/^# fuck-omarchy:args=/Usage: fuck-omarchy-shell-audit /p' "$0"; exit 0 ;;
    *) profile="$arg" ;;
  esac
done

dir=$([[ -n $profile ]] && FUCK_OMARCHY_SHELL_PROFILE="$profile" fuck-omarchy-shell-dir || fuck-omarchy-shell-dir) || exit 1
plugins="$dir/plugins"
[[ -d $plugins ]] || { echo "no plugins/ in $dir" >&2; exit 1; }

names=$(for d in "$plugins"/*/; do basename "$d"; done)
all_ids=$(for d in "$plugins"/*/; do jq -r '.id' "${d}manifest.json" 2>/dev/null; done)
violations=0

printf '%-24s %-6s %-6s %-22s %s\n' PLUGIN COMMONS UI "CALLS (by capability)" "PROBLEMS"
for d in "$plugins"/*/; do
  name=$(basename "$d")
  [[ -f ${d}manifest.json ]] || continue
  id=$(jq -r '.id' "${d}manifest.json")
  files=$(find "$d" -type f \( -name '*.qml' -o -name '*.js' \))

  commons=no; ui=no
  [[ -n $files ]] && grep -lE '^import qs\.Commons' $files >/dev/null 2>&1 && commons=yes
  [[ -n $files ]] && grep -lE '^import qs\.Ui' $files >/dev/null 2>&1 && ui=yes

  problems=()
  host=0
  jq -e '.kinds | index("bar")' "${d}manifest.json" >/dev/null 2>&1 && host=1

  # 1. relative paths that leave the plugin folder into a sibling plugin
  for other in $names; do
    [[ $other == "$name" ]] && continue
    if [[ -n $files ]] && grep -qE "\"\.\./(\.\./)*(plugins/)?$other/|\"\.\./$other\"|\.\./\.\./plugins/$other" $files 2>/dev/null; then
      problems+=("imports $other"); violations=$((violations+1))
    fi
  done

  # 2. hard-coded ids of other plugins in code (manifests excluded)
  others=$(
    [[ -n $files ]] && grep -hoE  '"[A-Za-z0-9._-]+"' $files 2>/dev/null |
      tr -d '"' | sort -u | grep -xFf <(printf '%s\n' "$all_ids") | grep -vxF "$id" | grep -vxF "fuck-omarchy.${name#skyy}" | tr '\n' ' '
  )
  # A bar hosts other plugins' widgets, so naming them in its layout is its job.
  if (( host )); then
    others=""
  fi
  if [[ -n ${others// } ]]; then
    problems+=("hard-coded ids: ${others% }"); violations=$((violations+1))
  fi

  calls=$(
    [[ -n $files ]] && grep -hoE '(summon|firstPartyServiceFor)\("[a-z0-9.-]+"' $files 2>/dev/null |
      sed -E 's/.*\("//; s/"$//' | sort -u | tr '\n' ',' | sed 's/,$//'
  )
  # every call must be declared in fuck_omarchy.uses (or be the plugin's own id)
  for c in ${calls//,/ }; do
    jq -e --arg c "$c" --arg id "$id" '(.fuck_omarchy.uses // []) | index($c)' "${d}manifest.json" >/dev/null 2>&1 || {
      # bar-hosted widgets inherit the bar's reach; only flag plugins that are not widgets of the bar
      (( host )) || jq -e '.kinds | index("bar-widget")' "${d}manifest.json" >/dev/null 2>&1 || { problems+=("undeclared use: $c"); violations=$((violations+1)); }
    }
  done

  printf '%-24s %-6s %-6s %-22s %s\n' "$name" "$commons" "$ui" "${calls:--}" "${problems[*]:-ok}"
done

echo
echo "Kit (shared look and widgets): $(ls "$dir/Commons" 2>/dev/null | wc -l) files in Commons/, $(ls "$dir/Ui" 2>/dev/null | wc -l) in Ui/"
echo "Providers:"
for d in "$plugins"/*/; do
  [[ -f ${d}manifest.json ]] && jq -r '. as $m | (.fuck_omarchy.provides // [])[] | "  \(.) -> \($m.id)"' "${d}manifest.json"
done | sort
(( violations )) && echo && echo "$violations modularity problem(s)."
(( strict && violations )) && exit 1
exit 0
