#!/bin/bash

# fuck-omarchy:summary=Play a random password-prompt clip from the assets folder, pausing music while it plays (used by the polkit dialog)
# fuck-omarchy:group=sound

# Plays one random clip from $FUCK_OMARCHY_ASSETS/audio/password (default ~/Assets/audio/password).
# Silent while the output is muted or at 0%.
#
# While the clip plays, anything that is playing (any MPRIS player: Zen's YouTube
# and YouTube Music, Spotify, mpv...) is paused, and only those players are
# resumed afterwards.
#
# Volume: on the built-in speaker it is raised to full for the clip; on
# headphones (jack, Bluetooth, USB) it is raised to at least half (never
# lowered) so a quiet system volume doesn't swallow the clip; HDMI plays as is.
# Everything is put back afterwards.

dir="${FUCK_OMARCHY_ASSETS:-$HOME/Assets}/audio/password"
loud=1.0         # built-in speaker volume while the clip plays
headphones=0.5   # headphones are raised to at least this while it plays
clip=0.8         # clip loudness on headphones

mapfile -t clips < <(find "$dir" -maxdepth 1 -type f \( -iname '*.ogg' -o -iname '*.oga' -o -iname '*.wav' -o -iname '*.mp3' -o -iname '*.flac' -o -iname '*.opus' \) 2>/dev/null)
(( ${#clips[@]} )) || exit 0
sound=${clips[RANDOM % ${#clips[@]}]}

# One alert at a time, so a second one never saves the boosted volume as the old one
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/fuck-omarchy-sound-password.lock"
flock -n 9 || exit 0

# A previous run that was killed hard (power button, kill -9) can leave the volume
# boosted. It records the original volume here; put it back before doing anything.
state="${XDG_RUNTIME_DIR:-/tmp}/fuck-omarchy-sound-password.volume"
if [[ -r $state ]]; then
  read -r stale_id stale_vol stale_boost <"$state"
  [[ $(wpctl get-volume "$stale_id" 2>/dev/null) == "Volume: $stale_boost"* ]] && wpctl set-volume "$stale_id" "$stale_vol"
  rm -f "$state"
fi

info=$(wpctl inspect @DEFAULT_AUDIO_SINK@) || exit 0
id=$(awk 'NR == 1 { sub(",", "", $2); print $2 }' <<<"$info")
sink=$(sed -n 's/.*node.name = "\(.*\)"/\1/p' <<<"$info")

vol=$(wpctl get-volume "$id") || exit 0
[[ $vol == *MUTED* ]] && exit 0
vol=${vol#Volume: }
vol=${vol%% *}
awk -v v="$vol" 'BEGIN { exit !(v > 0) }' || exit 0

case $sink in
  *HDMI*) boost=""; level=1.0 ;;
  *Speaker__sink) boost=$loud; level=1.0 ;;
  *) boost=$headphones; level=$clip ;;
esac

# Only ever raise the volume
if [[ -n $boost ]] && ! awk -v v="$vol" -v b="$boost" 'BEGIN { exit !(v < b) }'; then
  boost=""
fi

mpris_call() { busctl --user call "$1" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player "$2" >/dev/null 2>&1; }

paused=()
pause_music() {
  local name status
  while read -r name; do
    status=$(busctl --user get-property "$name" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player PlaybackStatus 2>/dev/null | awk -F'"' '{print $2}')
    if [[ $status == Playing ]]; then
      mpris_call "$name" Pause && paused+=("$name")
    fi
  done < <(busctl --user list --no-legend 2>/dev/null | awk '$1 ~ /^org\.mpris\.MediaPlayer2\./ { print $1 }')
}

resume_music() {
  local name
  for name in "${paused[@]}"; do mpris_call "$name" Play; done
  paused=()
}

restore_volume() {
  [[ -n $boost ]] || return 0
  # Leave it alone if the volume was changed while the clip played
  [[ $(wpctl get-volume "$id") == "Volume: $boost"* ]] && wpctl set-volume "$id" "$vol"
  rm -f "$state"
}

cleanup() {
  [[ -n ${player_pid:-} ]] && kill "$player_pid" 2>/dev/null
  restore_volume
  resume_music
}
trap 'cleanup; exit' TERM INT HUP
trap cleanup EXIT

pause_music
if [[ -n $boost ]]; then
  printf '%s %s %s\n' "$id" "$vol" "$boost" >"$state"
  wpctl set-volume "$id" "$boost"
fi
pw-play --volume "$level" "$sound" &
player_pid=$!
wait "$player_pid"
player_pid=""
