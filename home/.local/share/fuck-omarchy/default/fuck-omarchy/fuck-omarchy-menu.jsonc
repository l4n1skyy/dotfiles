{
  // fuck-omarchy menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. Use provider:"name" only when the submenu
  // calls provider_name() or a command named "name" to return JSON rows.
  // Optional fields:
  //   aliases        alternate `fuck-omarchy menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"fuck-omarchy-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"fuck-omarchy-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"fuck-omarchy-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! fuck-omarchy-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"fuck-omarchy-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"fuck-omarchy-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"fuck-omarchy-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"fuck-omarchy-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"fuck-omarchy-menu-keybindings"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"fuck-omarchy-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"fuck-omarchy-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"skyymenu-nvim"},
  "learn.neovim-docs": {"icon":"","label":"LazyVim docs","action":"fuck-omarchy-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"fuck-omarchy-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"fuck-omarchy-menu-tmux-keybindings"},
  "learn.custom": {"icon":"󰒓","label":"My commands","aliases":["custom","commands","update","cleanup"],"action":"skyymenu-custom"},
  "learn.obsidian-keybindings": {"icon":"󰓧","label":"Obsidian","when":"command -v obsidian","action":"skyymenu-obsidian"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"fuck-omarchy-menu-emoji"},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"fuck-omarchy-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"fuck-omarchy-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"fuck-omarchy-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"fuck-omarchy-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"fuck-omarchy-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"fuck-omarchy-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"fuck-omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"fuck-omarchy-hw-webcam","action":"fuck-omarchy-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"fuck-omarchy-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"fuck-omarchy-hw-laptop","action":"fuck-omarchy-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"fuck-omarchy-hw-laptop","action":"fuck-omarchy-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"fuck-omarchy-hw-hybrid-gpu","action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"fuck-omarchy-hw-touchpad","action":"fuck-omarchy-toggle-touchpad"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"fuck-omarchy-hw-touchscreen","action":"fuck-omarchy-toggle-touchscreen"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"fuck-omarchy-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"fuck-omarchy-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"fuck-omarchy-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"fuck-omarchy-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"fuck-omarchy-toggle-notification-silencing"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"fuck-omarchy-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"fuck-omarchy-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"fuck-omarchy-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"fuck-omarchy-hw-laptop","action":"fuck-omarchy-shell fuck-omarchy.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"fuck-omarchy-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"fuck-omarchy-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"fuck-omarchy-hyprland-window-single-square-aspect-toggle"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(fuck-omarchy-theme-switcher); [[ -n $theme ]] && fuck-omarchy-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(fuck-omarchy-theme-bg-switcher); [[ -n $background ]] && fuck-omarchy-theme-bg-set \"$background\""},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"fuck-omarchy-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"fuck-omarchy-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"fuck-omarchy-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"fuck-omarchy-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"fuck-omarchy-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"fuck-omarchy-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"fuck-omarchy-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"fuck-omarchy-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"fuck-omarchy-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"fuck-omarchy-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"fuck-omarchy-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"fuck-omarchy-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"fuck-omarchy-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"fuck-omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"fuck-omarchy-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(fuck-omarchy-dns)\" == \"DHCP\" ]]","action":"fuck-omarchy-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(fuck-omarchy-dns)\" == \"Cloudflare\" ]]","action":"fuck-omarchy-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(fuck-omarchy-dns)\" == \"Google\" ]]","action":"fuck-omarchy-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(fuck-omarchy-dns)\" == \"Custom\" ]]","action":"fuck-omarchy-launch-floating-terminal-with-presentation 'fuck-omarchy-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(fuck-omarchy-network-status) == wifi* ]]","action":"fuck-omarchy-shell shell summon fuck-omarchy.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"fuck-omarchy-cmd-present chromium","checked":"[[ \"$(fuck-omarchy-default-browser)\" == \"chromium\" ]]","action":"fuck-omarchy-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"fuck-omarchy-cmd-present google-chrome-stable","checked":"[[ \"$(fuck-omarchy-default-browser)\" == \"chrome\" ]]","action":"fuck-omarchy-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"fuck-omarchy-cmd-present brave","checked":"[[ \"$(fuck-omarchy-default-browser)\" == \"brave\" ]]","action":"fuck-omarchy-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","when":"fuck-omarchy-cmd-present brave-origin","checked":"[[ \"$(fuck-omarchy-default-browser)\" == \"brave-origin\" ]]","action":"fuck-omarchy-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"fuck-omarchy-cmd-present microsoft-edge-stable","checked":"[[ \"$(fuck-omarchy-default-browser)\" == \"edge\" ]]","action":"fuck-omarchy-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"fuck-omarchy-cmd-present firefox","checked":"[[ \"$(fuck-omarchy-default-browser)\" == \"firefox\" ]]","action":"fuck-omarchy-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"fuck-omarchy-cmd-present zen-browser","checked":"[[ \"$(fuck-omarchy-default-browser)\" == \"zen\" ]]","action":"fuck-omarchy-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"fuck-omarchy-cmd-present alacritty","checked":"[[ \"$(fuck-omarchy-default-terminal)\" == \"alacritty\" ]]","action":"fuck-omarchy-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"fuck-omarchy-cmd-present foot","checked":"[[ \"$(fuck-omarchy-default-terminal)\" == \"foot\" ]]","action":"fuck-omarchy-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"fuck-omarchy-cmd-present ghostty","checked":"[[ \"$(fuck-omarchy-default-terminal)\" == \"ghostty\" ]]","action":"fuck-omarchy-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"fuck-omarchy-cmd-present kitty","checked":"[[ \"$(fuck-omarchy-default-terminal)\" == \"kitty\" ]]","action":"fuck-omarchy-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","when":"fuck-omarchy-cmd-present nvim","checked":"[[ \"$(fuck-omarchy-default-editor)\" == \"nvim\" ]]","action":"fuck-omarchy-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","when":"fuck-omarchy-cmd-present code","checked":"[[ \"$(fuck-omarchy-default-editor)\" == \"code\" ]]","action":"fuck-omarchy-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","iconFont":"omarchy","label":"Cursor","when":"fuck-omarchy-cmd-present cursor","checked":"[[ \"$(fuck-omarchy-default-editor)\" == \"cursor\" ]]","action":"fuck-omarchy-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","when":"fuck-omarchy-cmd-present zeditor","checked":"[[ \"$(fuck-omarchy-default-editor)\" == \"zeditor\" ]]","action":"fuck-omarchy-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"fuck-omarchy-cmd-present sublime_text","checked":"[[ \"$(fuck-omarchy-default-editor)\" == \"sublime_text\" ]]","action":"fuck-omarchy-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"fuck-omarchy-cmd-present helix","checked":"[[ \"$(fuck-omarchy-default-editor)\" == \"helix\" ]]","action":"fuck-omarchy-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"fuck-omarchy-cmd-present vim","checked":"[[ \"$(fuck-omarchy-default-editor)\" == \"vim\" ]]","action":"fuck-omarchy-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"fuck-omarchy-cmd-present emacs","checked":"[[ \"$(fuck-omarchy-default-editor)\" == \"emacs\" ]]","action":"fuck-omarchy-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"fuck-omarchy-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"fuck-omarchy-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"fuck-omarchy-launch-floating-terminal-with-presentation 'fuck-omarchy-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"fuck-omarchy-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/fuck-omarchy/plugins/*/manifest.json\"","action":"fuck-omarchy-menu-plugin remove"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"fuck-omarchy-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"fuck-omarchy-launch-config-editor ~/.config/hypr/hyprsunset.conf && fuck-omarchy-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"fuck-omarchy-launch-config-editor ~/.XCompose && fuck-omarchy-restart-xcompose"},



  // Update
  "update.all": {"icon":"󰚰","label":"Everything","aliases":["all","flatpak","pipx","mise","npm"],"action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-update-all"},
  "update.system": {"icon":"","label":"System","aliases":["upgrade"],"action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-update"},
  "update.process": {"icon":"","label":"Process","title":"Restart"},
  "update.hardware": {"icon":"󰇅","label":"Hardware","title":"Restart"},
  "update.firmware": {"icon":"","label":"Firmware","action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-update-firmware"},
  "update.password": {"icon":"","label":"Password"},
  "update.timezone": {"icon":"","label":"Timezone","action":"fuck-omarchy-menu-timezone"},
  "update.time": {"icon":"","label":"Time","action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-update-time"},
  "update.process.hyprsunset": {"icon":"","label":"Hyprsunset","action":"fuck-omarchy-restart-hyprsunset"},
  "update.process.shell": {"icon":"󰍜","label":"Shell","action":"fuck-omarchy-restart-shell"},
  "update.hardware.audio": {"icon":"","label":"Audio","action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-restart-audio"},
  "update.hardware.wifi": {"icon":"󱚾","label":"Wi-Fi","action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-restart-wifi"},
  "update.hardware.bluetooth": {"icon":"󰂯","label":"Bluetooth","action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-restart-bluetooth"},
  "update.hardware.trackpad": {"icon":"󰟸","label":"Trackpad","action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-restart-trackpad"},
  "update.password.drive": {"icon":"","label":"Drive Encryption","action":"fuck-omarchy-launch-floating-terminal-with-presentation fuck-omarchy-drive-password"},
  "update.password.user": {"icon":"","label":"User","action":"fuck-omarchy-launch-floating-terminal-with-presentation passwd"},
}
