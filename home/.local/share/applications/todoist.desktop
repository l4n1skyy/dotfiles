[Desktop Entry]
Version=1.0
Type=Application
Name=Todoist
Comment=Task Management
# Opens as a web app in the same Chromium profile as the other web apps
Exec=omarchy-launch-webapp https://app.todoist.com/app/today
Icon=/home/l4n1skyy/.local/share/icons/todoist_new.webp
Terminal=false
# This identifies the window for Hyprland rules
StartupWMClass=app.todoist.com
Categories=Office;Utility;
