#!/usr/bin/env python3
"""skyyytlike: like / unlike the YouTube Music track playing in Pear Desktop,
for the heart button of the bar's media module (skyymedia).

  skyyytlike status VIDEO_ID   prints LIKE or INDIFFERENT (or DISLIKE)
  skyyytlike toggle VIDEO_ID   like if not liked, otherwise remove the like;
                               prints the new state

Uses Pear's API server plugin (listening on 127.0.0.1 only), which presses the
app's own like button, so the heart in the app changes at once. The client id
"skyyytlike" is pre-authorised in Pear's config, so Pear never asks; if it is
missing from there this never asks for it either (that would pop up a dialog in
Pear every few seconds) and just fails.

Exits with an error (printing nothing) when Pear isn't running or plays a
different track. The old Zen window's version is in
~/.local/bin/hypr/skyyytmusic-zen/ (backup, not in use).
"""
import json, os, sys, time, urllib.request

PEAR_CONFIG = os.path.expanduser("~/.config/YouTube Music/config.json")
CLIENT = "skyyytlike"


def pear_api():
    """A call(method, path) function for Pear's API."""
    try:
        cfg = json.load(open(PEAR_CONFIG))["plugins"]["api-server"]
    except (OSError, ValueError, KeyError):
        sys.exit("skyyytlike: Pear's API server plugin isn't set up")
    if not cfg.get("enabled") or CLIENT not in cfg.get("authorizedClients", []) or cfg.get("useHttps"):
        sys.exit(f"skyyytlike: Pear's API server is off, or {CLIENT!r} isn't an authorised client")
    base = f"http://127.0.0.1:{cfg.get('port', 26538)}"

    def req(method, path, token=None):
        r = urllib.request.Request(base + path, method=method, data=b"" if method == "POST" else None,
                                   headers={"Authorization": f"Bearer {token}"} if token else {})
        with urllib.request.urlopen(r, timeout=2) as resp:
            body = resp.read()
        return json.loads(body) if body else None

    try:
        token = req("POST", f"/auth/{CLIENT}")["accessToken"]
    except OSError:
        sys.exit("skyyytlike: Pear Desktop isn't running")
    return lambda method, path: req(method, path, token)


def like_state(call):
    return ((call("GET", "/api/v1/like-state") or {}).get("state") or "INDIFFERENT").replace("LIKE_STATUS_", "")


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in ("status", "toggle"):
        sys.exit(__doc__)
    cmd, vid = sys.argv[1:]
    call = pear_api()
    song = call("GET", "/api/v1/song")
    if not song or song.get("videoId") != vid:
        sys.exit("skyyytlike: Pear isn't playing that track")
    state = like_state(call)
    if cmd == "toggle":
        call("POST", "/api/v1/like")  # Pear's like presses the like button: likes, or removes the like
        for _ in range(15):  # the page updates its button a moment later
            time.sleep(0.1)
            new = like_state(call)
            if new != state:
                break
        state = new
    print(state)


main()
