#!/usr/bin/env bash
# dotfiles: copy the configs listed in ~/dotfiles/dotfiles.conf into ~/dotfiles,
# scrub secrets, regenerate README.md, and (with --push) commit and push to GitHub.

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
CONF="$DOTFILES_DIR/dotfiles.conf"
FO_PATH="${FO_PATH:-$HOME/.local/share/fuck-omarchy}"
AREAS=(home root packages)

# Well-known secret formats, scrubbed from every copied file and checked before every push.
SECRET_FORMATS='(?<![A-Za-z0-9])(?:sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|glpat-[A-Za-z0-9_-]{20,}|hf_[A-Za-z0-9]{30,})|-----BEGIN [A-Z ]*PRIVATE KEY-----'

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m:: %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[1;31m:: %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
    cat <<EOF
Usage: dotfiles [options]

Copies everything listed in $CONF
into $DOTFILES_DIR, scrubs secrets and regenerates README.md.

  -p, --push         also commit and push to GitHub
  -m, --message MSG  commit message for --push (default: lists what changed)
  -n, --dry-run      show what would change without touching anything
  -e, --edit         open dotfiles.conf in \$EDITOR
  -h, --help         show this help
EOF
}

# --- ARGS ---------------------------------------------------------------------
PUSH=0 DRY=0 MSG=""
while (( $# )); do
    case "$1" in
        -p|--push)    PUSH=1 ;;
        -m|--message) [[ $# -ge 2 ]] || die "$1 needs a message"; MSG="$2"; shift ;;
        -n|--dry-run) DRY=1 ;;
        -e|--edit)    exec "${EDITOR:-nvim}" "$CONF" ;;
        -h|--help)    usage; exit 0 ;;
        *)            usage >&2; die "unknown option: $1" ;;
    esac
    shift
done
(( PUSH && DRY )) && die "--push and --dry-run can't be combined"

[[ -d "$DOTFILES_DIR" ]] || die "$DOTFILES_DIR doesn't exist (git clone your dotfiles repo there first)"
[[ -f "$CONF" ]] || die "missing $CONF"
for tool in rsync perl git; do command -v "$tool" >/dev/null || die "$tool is not installed"; done

# --- CONFIG -------------------------------------------------------------------
declare -a INCLUDES=() INCLUDE_DESC=() INCLUDE_SEC=() INCLUDE_IF=() INCLUDE_IF_DESC=() INCLUDE_IF_SEC=() EXCLUDES=() REDACT=()
declare -a SECTIONS=() USE_SEC=() USE_PART=() USE_WHAT=() USE_NEEDS=()
declare -A OPT=([remote]="" [branch]="master" [skip_stock]="yes" [links]="safe" [max_size]="5M" [packages]="yes") SEEN_SECTION=()
SECTION_RE='^# --- (.*[^ -])[ -]*$'

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

lineno=0 section=""
while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"
    # `# --- Name ---` headers become the README's sections
    if [[ "$line" =~ $SECTION_RE ]]; then
        section="${BASH_REMATCH[1]}"
        [[ -n "${SEEN_SECTION[$section]-}" ]] || { SECTIONS+=("$section"); SEEN_SECTION[$section]=1; }
        continue
    fi
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    desc=""
    if [[ "$line" == *" #"* ]]; then
        desc="${line#* #}"; desc="${desc#"${desc%%[![:space:]]*}"}"
        line="${line%% #*}"
    fi
    read -r key rest <<<"$line"
    case "$key" in
        include)    INCLUDES+=("$rest"); INCLUDE_DESC+=("$desc"); INCLUDE_SEC+=("$section") ;;
        include-if) INCLUDE_IF+=("$rest"); INCLUDE_IF_DESC+=("$desc"); INCLUDE_IF_SEC+=("$section") ;;
        use)        IFS='|' read -r part what needs <<<"$rest"
                    [[ -n "$(trim "$what")" ]] || { warn "dotfiles.conf:$lineno: use needs '<part> | <what>'"; continue; }
                    USE_SEC+=("$section"); USE_PART+=("$(trim "$part")"); USE_WHAT+=("$(trim "$what")"); USE_NEEDS+=("$(trim "$needs")") ;;
        exclude)    EXCLUDES+=("$rest") ;;
        redact)     REDACT+=("$rest") ;;
        set)        read -r k v <<<"$rest"; OPT[$k]="$v" ;;
        *)          warn "dotfiles.conf:$lineno: unknown directive '$key' (ignored)" ;;
    esac
done < "$CONF"

# --- STAGE: build a fresh copy in a temp folder --------------------------------
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
EXCLUDE_FILE="$STAGE/.excludes"
printf '%s\n' "${EXCLUDES[@]}" > "$EXCLUDE_FILE"
RSYNC_OPTS=(-a --relative --no-specials --no-devices --exclude-from="$EXCLUDE_FILE" --max-size="${OPT[max_size]}")
[[ "${OPT[links]}" == safe ]] && RSYNC_OPTS+=(--safe-links)

# Where a source path lives inside the repo: ~/x -> home/x, /etc/x -> root/etc/x
repo_path() {
    if [[ "$1" == "$HOME"/* ]]; then printf 'home/%s' "${1#"$HOME"/}"; else printf 'root/%s' "${1#/}"; fi
}

copy_into_stage() {
    local src="$1" rc=0
    if [[ "$src" == "$HOME"/* ]]; then
        rsync "${RSYNC_OPTS[@]}" "$HOME/./${src#"$HOME"/}" "$STAGE/home/" || rc=$?
    else
        mkdir -p "$STAGE/root"
        rsync "${RSYNC_OPTS[@]}" "/./${src#/}" "$STAGE/root/" || rc=$?
    fi
    # 23/24 = some files unreadable or vanished mid-copy: keep the rest
    case "$rc" in
        0) ;;
        23|24) warn "some files under $src couldn't be copied" ;;
        *) die "rsync failed on $src (exit $rc)" ;;
    esac
}

expand() { # spec -> matching absolute paths, one per line
    local spec="$1"
    [[ "$spec" == /* ]] || spec="$HOME/$spec"
    compgen -G "$spec" || true
}

mkdir -p "$STAGE/home"
declare -a ROW_PATHS=() ROW_DESCS=() ROW_SECS=() MISSING=()
for i in "${!INCLUDES[@]}"; do
    found=0
    while IFS= read -r src; do
        [[ -n "$src" ]] || continue
        copy_into_stage "$src"
        found=1
    done < <(expand "${INCLUDES[$i]}")
    if (( found )); then
        ROW_PATHS+=("${INCLUDES[$i]}"); ROW_DESCS+=("${INCLUDE_DESC[$i]}"); ROW_SECS+=("${INCLUDE_SEC[$i]}")
    else
        MISSING+=("${INCLUDES[$i]}")
    fi
done

for i in "${!INCLUDE_IF[@]}"; do
    read -r glob regex <<<"${INCLUDE_IF[$i]}"
    found=0
    while IFS= read -r src; do
        [[ -f "$src" ]] && grep -qE -- "$regex" "$src" || continue
        copy_into_stage "$src"
        found=1
    done < <(expand "$glob")
    (( found )) && { ROW_PATHS+=("$glob"); ROW_DESCS+=("${INCLUDE_IF_DESC[$i]}"); ROW_SECS+=("${INCLUDE_IF_SEC[$i]}"); }
done
rm -f "$EXCLUDE_FILE"

# Files identical to fuck-omarchy's shipped defaults aren't customisations.
stock_skipped=0
if [[ "${OPT[skip_stock]}" == yes && -d "$STAGE/home/.config" && -d "$FO_PATH/config" ]]; then
    while IFS= read -r -d '' f; do
        rel="${f#"$STAGE"/home/.config/}"
        if [[ -f "$FO_PATH/config/$rel" ]] && cmp -s "$f" "$FO_PATH/config/$rel"; then
            rm -f "$f"
            stock_skipped=$((stock_skipped + 1))
        fi
    done < <(find "$STAGE/home/.config" -type f -print0)
fi

# --- SECRETS ------------------------------------------------------------------
redacted_files=()
note_redacted() { redacted_files+=("${1#"$STAGE"/}"); }

# 1. Named keys: `X_API_KEY=...`, `"apiKey": "..."`, `token = "..."` (12+ char values with a digit)
REDACT_RE="$(IFS='|'; printf '%s' "${REDACT[*]}")"
if [[ -n "$REDACT_RE" ]]; then
    while IFS= read -r -d '' f; do
        before="$(cksum < "$f")"
        REDACT_RE="$REDACT_RE" perl -pi -e '
            BEGIN { $re = qr/$ENV{REDACT_RE}/i }
            s~(?<q>["\x27]?)(?<name>\b[\w.-]*(?:$re)[\w.-]*)\k<q>(?<sep>\s*[:=]\s*)(?<vq>["\x27]?)(?![\$<])(?=[^"\x27\s,;]*\d)[A-Za-z0-9_+/=.:-]{12,}\k<vq>(?=[\s,;})\]]|$)~$+{q}$+{name}$+{q}$+{sep}$+{vq}<redacted>$+{vq}~g
        ' "$f"
        [[ "$(cksum < "$f")" != "$before" ]] && note_redacted "$f"
    done < <(grep -rlIZ -iE -- "$REDACT_RE" "$STAGE" || true)
fi

# 2. The live values of your exported secret variables, wherever they appear
if [[ -n "$REDACT_RE" ]]; then
    shopt -s nocasematch
    while IFS= read -r name; do
        [[ "$name" =~ $REDACT_RE ]] || continue
        val="${!name-}"
        (( ${#val} >= 12 )) || continue
        while IFS= read -r -d '' f; do
            SECRET_VALUE="$val" perl -pi -e 's/\Q$ENV{SECRET_VALUE}\E/<redacted>/g' "$f"
            note_redacted "$f"
        done < <(grep -rlIZF -f <(printf '%s\n' "$val") "$STAGE" || true)
    done < <(compgen -e)
    shopt -u nocasematch
fi

# 3. Well-known key formats
while IFS= read -r -d '' f; do
    SECRET_FORMATS="$SECRET_FORMATS" perl -pi -e 'BEGIN { $re = qr/$ENV{SECRET_FORMATS}/ } s/$re/<redacted>/g' "$f"
    note_redacted "$f"
done < <(grep -rlIZP -- "$SECRET_FORMATS" "$STAGE" || true)

mapfile -t redacted_files < <(printf '%s\n' "${redacted_files[@]}" | sort -u | sed '/^$/d')

# --- PACKAGES -----------------------------------------------------------------
if [[ "${OPT[packages]}" == yes ]] && command -v pacman >/dev/null; then
    mkdir -p "$STAGE/packages"
    stock_pkgs="$(cat "$FO_PATH"/install/*.packages 2>/dev/null | sed 's/#.*//' | awk 'NF {print $1}' | sort -u || true)"
    comm -23 <(pacman -Qqen | sort) <(printf '%s\n' "$stock_pkgs") > "$STAGE/packages/pacman.txt"
    comm -23 <(pacman -Qqem | sort) <(printf '%s\n' "$stock_pkgs") > "$STAGE/packages/aur.txt"
    if command -v flatpak >/dev/null; then
        flatpak list --app --columns=application 2>/dev/null | sort -u > "$STAGE/packages/flatpak.txt" || true
    fi
    find "$STAGE/packages" -type f -empty -delete
fi

find "$STAGE" -mindepth 1 -type d -empty -delete

# --- SYNC STAGE -> REPO ---------------------------------------------------------
if (( DRY )); then
    info "Dry run: changes that would be made in $DOTFILES_DIR"
    for area in "${AREAS[@]}"; do
        if [[ -d "$STAGE/$area" ]]; then
            rsync -a --delete --checksum -n -i "$STAGE/$area/" "$DOTFILES_DIR/$area/" | sed "s|^|  $area/ |"
        elif [[ -d "$DOTFILES_DIR/$area" ]]; then
            echo "  would remove $area/"
        fi
    done
    (( ${#redacted_files[@]} )) && info "Secrets would be redacted in: ${redacted_files[*]}"
    (( ${#MISSING[@]} )) && warn "Not found (skipped): ${MISSING[*]}"
    info "README.md would be regenerated"
    exit 0
fi

for area in "${AREAS[@]}"; do
    if [[ -d "$STAGE/$area" ]]; then
        rsync -a --delete --checksum "$STAGE/$area/" "$DOTFILES_DIR/$area/"
    else
        rm -rf "${DOTFILES_DIR:?}/$area"
    fi
done

# --- README -------------------------------------------------------------------
README="$DOTFILES_DIR/README.md"
CUSTOM_START='<!-- custom:start (your own notes; kept as-is on every sync) -->'
CUSTOM_END='<!-- custom:end -->'

custom_block=""
if [[ -f "$README" ]] && grep -qF -- "$CUSTOM_END" "$README"; then
    custom_block="$(awk -v s='<!-- custom:start' -v e="$CUSTOM_END" 'index($0,s)==1{on=1;next} index($0,e)==1{on=0} on' "$README")"
fi
[[ -n "$custom_block" ]] || custom_block="My Arch + Hyprland (fuck-omarchy) setup."

declare -A PKG_VER=()
if command -v pacman >/dev/null; then
    while read -r name ver; do PKG_VER[$name]="$ver"; done < <(pacman -Q)
fi
FLATPAKS=" $(flatpak list --app --columns=application 2>/dev/null | paste -sd' ' || true) "

installed() { # a pacman package, Flatpak app or command
    [[ -n "${PKG_VER[$1]-}" || "$FLATPAKS" == *" $1 "* ]] || command -v "$1" >/dev/null
}

# Expand the {placeholders} in a `use` value. If one comes up empty, prints it and fails.
PLACEHOLDER_RE='\{([a-z-]+)(:([^}]+))?\}'
fill() {
    local s="$1" whole key arg val
    while [[ "$s" =~ $PLACEHOLDER_RE ]]; do
        whole="${BASH_REMATCH[0]}" key="${BASH_REMATCH[1]}" arg="${BASH_REMATCH[3]}" val=""
        case "$key" in
            ver)   [[ -n "$arg" ]] && val="${PKG_VER[$arg]-}"; val="${val#*:}"; val="${val%-*}" ;;
            theme) val="$("$FO_PATH/bin/fo-theme-current" 2>/dev/null || true)" ;;
            font)  val="$(fc-match -f '%{family[0]}' monospace 2>/dev/null || true)" ;;
            gtk-theme|icon-theme)
                   val="$(gsettings get org.gnome.desktop.interface "$key" 2>/dev/null | tr -d "'" || true)" ;;
            webapps)
                   val="$(grep -h '^Name=' "$DOTFILES_DIR"/home/.local/share/applications/*.desktop 2>/dev/null \
                          | cut -d= -f2- | sort -f | paste -sd, | sed 's/,/, /g' || true)" ;;
        esac
        [[ -n "$val" ]] || { printf '%s' "$whole"; return 1; }
        s="${s/"$whole"/"$val"}"
    done
    printf '%s' "$s"
}

repo_link() { # where an include spec lives in the repo; a glob links to its folder
    local spec="$1" p
    [[ "$spec" == /* ]] || spec="$HOME/$spec"
    p="$(repo_path "$spec")"
    case "$p" in *[*?[]*) p="${p%/*}" ;; esac
    printf '%s' "$p"
}

count_files() { # files in the repo that came from one include spec
    local spec="$1" n=0 src
    while IFS= read -r src; do
        [[ -n "$src" ]] || continue
        local p="$DOTFILES_DIR/$(repo_path "$src")"
        if [[ -d "$p" ]]; then n=$((n + $(find "$p" -type f -o -type l | wc -l)))
        elif [[ -e "$p" || -L "$p" ]]; then n=$((n + 1)); fi
    done < <(expand "$spec")
    printf '%s' "$n"
}

stock_only=() skipped_uses=()
{
    printf '# dotfiles\n\n%s\n%s\n%s\n\n' "$CUSTOM_START" "$custom_block" "$CUSTOM_END"
    printf '<!-- Everything below is generated by `dotfiles`. Edit dotfiles.conf instead. -->\n\n'
    printf '_Last updated %s_\n\n' "$(date '+%Y-%m-%d %H:%M')"

    # One section per `# --- Name ---` header: what I use, then the configs
    for sec in "${SECTIONS[@]}" ""; do
        uses=() configs=()
        for i in "${!USE_PART[@]}"; do
            [[ "${USE_SEC[$i]}" == "$sec" ]] || continue
            missing=""
            for need in ${USE_NEEDS[$i]}; do installed "$need" || missing+=" $need"; done
            if [[ -n "$missing" ]]; then
                skipped_uses+=("${USE_PART[$i]} (not installed:$missing)")
            elif what="$(fill "${USE_WHAT[$i]}")"; then
                uses+=("| **${USE_PART[$i]}** | $what |")
            else
                skipped_uses+=("${USE_PART[$i]} ($what is empty)")
            fi
        done
        for i in "${!ROW_PATHS[@]}"; do
            [[ "${ROW_SECS[$i]}" == "$sec" ]] || continue
            n="$(count_files "${ROW_PATHS[$i]}")"
            if (( n == 0 )); then stock_only+=("${ROW_PATHS[$i]}"); continue; fi
            shown="${ROW_PATHS[$i]#"$HOME"/}"
            [[ "$shown" == /* ]] || shown="~/$shown"
            configs+=("- [\`$shown\`]($(repo_link "${ROW_PATHS[$i]}"))${ROW_DESCS[$i]:+: ${ROW_DESCS[$i]}}")
        done
        (( ${#uses[@]} + ${#configs[@]} )) || continue

        printf '## %s\n\n' "${sec:-Other}"
        if (( ${#uses[@]} )); then
            printf '| | |\n|---|---|\n'
            printf '%s\n' "${uses[@]}"
            printf '\n'
        fi
        if (( ${#configs[@]} )); then
            if (( ${#uses[@]} )); then printf 'Configs:\n\n'; fi
            printf '%s\n' "${configs[@]}"
            printf '\n'
        fi
    done

    if [[ -d "$DOTFILES_DIR/packages" ]]; then
        printf '## Packages\n\nEverything installed on purpose, one package per line:\n\n'
        for name in pacman.txt aur.txt flatpak.txt; do
            f="$DOTFILES_DIR/packages/$name"
            [[ -f "$f" ]] || continue
            case "$name" in
                pacman.txt)  from=" from the repos (pacman)" ;;
                aur.txt)     from=" from the AUR (yay)" ;;
                flatpak.txt) from=" from Flatpak" ;;
            esac
            printf -- '- [`packages/%s`](packages/%s): %s%s\n' "$name" "$name" "$(wc -l < "$f")" "$from"
        done
        printf '\n'
    fi

    cat <<'EOF'
## Restore on a new machine

`home/` mirrors `~` and `root/` mirrors `/`, so `home/.config/hypr` goes back to `~/.config/hypr`.

```bash
git clone https://github.com/l4n1skyy/dotfiles.git ~/dotfiles
rsync -av ~/dotfiles/home/ ~/                      # put the configs back
sudo pacman -S --needed - < ~/dotfiles/packages/pacman.txt
yay -S --needed - < ~/dotfiles/packages/aur.txt
```

EOF
    if (( ${#redacted_files[@]} )); then
        printf 'Secrets were replaced with `<redacted>` in %s; fill those in by hand.\n\n' \
            "$(printf '`%s`, ' "${redacted_files[@]}" | sed 's/, $//')"
    fi
    if (( ${#stock_only[@]} )); then
        printf 'Not copied because they match fuck-omarchy'\''s defaults: %s.\n\n' \
            "$(printf '`%s`, ' "${stock_only[@]}" | sed 's/, $//')"
    fi

    cat <<'EOF'
## Updating

```bash
dotfiles              # copy current configs here and rebuild this README
dotfiles -n           # preview what would change
dotfiles --push       # same as `dotfiles`, then commit and push to GitHub
dotfiles -p -m "msg"  # push with your own commit message
dotfiles --edit       # edit dotfiles.conf
```

The script lives at `~/.local/bin/system/dotfiles` (copied here under `home/.local/bin/system/`).
EOF
} > "$README.tmp"
sed -i "s|https://github.com/l4n1skyy/dotfiles.git|${OPT[remote]:-https://github.com/l4n1skyy/dotfiles.git}|" "$README.tmp"
# Only bump "Last updated" when something else changed, so idle syncs don't create commits.
if [[ -f "$README" ]] && cmp -s <(grep -v '^_Last updated ' "$README") <(grep -v '^_Last updated ' "$README.tmp"); then
    rm -f "$README.tmp"
else
    mv "$README.tmp" "$README"
fi

# --- REPORT -------------------------------------------------------------------
ok "Synced into $DOTFILES_DIR"
(( stock_skipped )) && info "$stock_skipped file(s) skipped because they match fuck-omarchy's defaults"
(( ${#redacted_files[@]} )) && info "Secrets redacted in: ${redacted_files[*]}"
(( ${#MISSING[@]} )) && warn "Not found (skipped): ${MISSING[*]}"
(( ${#skipped_uses[@]} )) && warn "Left out of README.md: $(printf '%s, ' "${skipped_uses[@]}" | sed 's/, $//')"

if ! git -C "$DOTFILES_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    (( PUSH )) && die "$DOTFILES_DIR is not a git repo, can't push"
    exit 0
fi

changes="$(git -C "$DOTFILES_DIR" status --porcelain)"
if [[ -z "$changes" ]]; then
    info "No changes since the last commit"
else
    info "Changes since the last commit ($(wc -l <<<"$changes") paths):"
    head -n 40 <<<"$changes" | sed 's/^/   /'
    (( $(wc -l <<<"$changes") > 40 )) && echo "   ..."
fi
(( PUSH )) || exit 0

# --- PUSH ---------------------------------------------------------------------
cd "$DOTFILES_DIR"
branch="${OPT[branch]:-master}"
if [[ -n "${OPT[remote]}" ]]; then
    if git remote get-url origin >/dev/null 2>&1; then
        [[ "$(git remote get-url origin)" == "${OPT[remote]}" ]] || git remote set-url origin "${OPT[remote]}"
    else
        git remote add origin "${OPT[remote]}"
    fi
fi
git remote get-url origin >/dev/null 2>&1 || die "no git remote: add 'set remote <url>' to dotfiles.conf"

git add -A
# Last line of defence: refuse to commit anything that still looks like a key.
leaks="$(git ls-files -z | xargs -0 grep -nIoP -- "$SECRET_FORMATS" 2>/dev/null | sed -E 's/^([^:]+:[0-9]+):(.{6}).*/\1  (\2…)/' || true)"
if [[ -n "$leaks" ]]; then
    git reset -q
    die "Refusing to push, these still look like secrets:
$leaks
Add an 'exclude' or 'redact' line to dotfiles.conf and run again."
fi

if git diff --cached --quiet; then
    info "Nothing new to commit"
else
    if [[ -z "$MSG" ]]; then
        areas="$(git diff --cached --name-only | awk -F/ '
            $1 == "home" && $2 == ".config" { print $3; next }
            $1 == "home" && $2 == ".local"  { print "scripts"; next }
            $1 == "home"                    { sub(/^\./, "", $2); print $2; next }
                                            { print $1 }' | sort -u | paste -sd, | sed 's/,/, /g')"
        MSG="sync: $areas"
        (( ${#MSG} > 72 )) && MSG="sync: $(git diff --cached --name-only | wc -l) files across $(tr -cd , <<<"$areas" | wc -c | awk '{print $1 + 1}') areas"
    fi
    git commit -q -m "$MSG"
    ok "Committed: $MSG"
fi

if ! git push -q -u origin "HEAD:$branch" 2>/dev/null; then
    info "Push rejected, pulling remote changes first"
    git pull -q --rebase origin "$branch" || die "Pull failed, resolve it in $DOTFILES_DIR and run 'git push'"
    git push -q -u origin "HEAD:$branch" || die "Push failed, check 'git -C $DOTFILES_DIR status'"
fi
ok "Pushed to $(git remote get-url origin) ($branch)"
