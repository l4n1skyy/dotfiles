#!/bin/bash
# Claude Code PreToolUse hook (Bash): play an alert when a command is about to
# ask for a password (pkexec / run0 open the polkit dialog).
# Silent while the output is muted or at 0%. On the built-in speaker the volume
# is raised to full for the clip and put back afterwards; on headphones
# (jack, Bluetooth, USB) the clip plays softly; HDMI plays it as is.

sound=~/.local/share/sounds/claude-password.oga
loud=1.0   # speaker volume while the clip plays
soft=0.25  # clip volume on headphones (system volume untouched)

jq -r '.tool_input.command // empty' | grep -qwE 'pkexec|run0' || exit 0

# One alert at a time, so a second one never saves the boosted volume as the old one
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/claude-password-sound.lock"
flock -n 9 || exit 0

info=$(wpctl inspect @DEFAULT_AUDIO_SINK@) || exit 0
id=$(awk 'NR == 1 { sub(",", "", $2); print $2 }' <<<"$info")
sink=$(sed -n 's/.*node.name = "\(.*\)"/\1/p' <<<"$info")

vol=$(wpctl get-volume "$id") || exit 0
[[ $vol == *MUTED* ]] && exit 0
vol=${vol#Volume: }
vol=${vol%% *}
awk -v v="$vol" 'BEGIN { exit !(v > 0) }' || exit 0

case $sink in
  *Speaker__sink) ;;
  *HDMI*) exec pw-play "$sound" ;;
  *) exec pw-play --volume "$soft" "$sound" ;;
esac

restore() {
  # Leave it alone if the volume was changed while the clip played
  [[ $(wpctl get-volume "$id") == "Volume: $loud"* ]] && wpctl set-volume "$id" "$vol"
}
trap 'kill $! 2>/dev/null; restore; exit' TERM INT
wpctl set-volume "$id" "$loud"
pw-play "$sound" &
wait $!
restore
