# Profile 1: Laptop Mode (When nothing is plugged in)
profile {
    output eDP-2 enable mode 2880x1920@120 position 0,0 scale 2
}

# Profile 2: Docked Mode (When HDMI is detected)
profile {
    # This is the 'magic' line that shuts off the laptop screen
    output eDP-2 disable
    
    # This activates your external monitor
    output HDMI-A-1 enable mode preferred position 0,0 scale 1
}
