{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "l4n1skyy.indicators",
          "items": [
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "format": "dddd ~ h:mm AP ~ d MMM",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/autostart",
          "fontSize": 16,
          "horizontalMargin": 8.75,
          "id": "system.autostart",
          "interval": 1,
          "onClick": "~/.local/bin/system/toggle-autostart.sh",
          "tooltip": "Startup apps",
          "type": "command"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/cpu",
          "horizontalMargin": 5,
          "id": "system.cpu",
          "interval": 1,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "tooltip": "CPU usage",
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/gpu",
          "horizontalMargin": 5,
          "id": "system.gpu",
          "interval": 1,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "tooltip": "GPU usage",
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/memory",
          "horizontalMargin": 5,
          "id": "system.memory",
          "interval": 1,
          "tooltip": "Memory usage",
          "type": "command"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "l4n1skyy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "l4n1skyy.notifications",
    "l4n1skyy.lock",
    "l4n1skyy.idle"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.lock",
    "omarchy.idle"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "l4n1skyy.notifications"
    },
    {
      "id": "l4n1skyy.lock"
    },
    {
      "id": "l4n1skyy.idle"
    }
  ],
  "version": 1
}
