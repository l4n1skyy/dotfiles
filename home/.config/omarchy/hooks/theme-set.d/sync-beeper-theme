#!/bin/bash

theme_colors="$HOME/.local/state/omarchy/current/theme/colors.toml"
beeper_css="$HOME/.config/BeeperTexts/custom.css"

[[ -f "$theme_colors" && -f "$beeper_css" ]] || exit 0

color() {
    awk -F '"' -v key="$1" '$0 ~ "^" key "[[:space:]]*=" { print $2; exit }' "$theme_colors"
}

replace_color() {
    local variable="$1"
    local value="$2"

    [[ -n "$value" ]] || return 0
    sed -i -E "s|^([[:space:]]*${variable}:[[:space:]]*)#[0-9A-Fa-f]{6}([[:space:]]*;[[:space:]]*\/\*.*)$|\1${value}\2|" "$beeper_css"
}

replace_color "--pomo-bg-deep" "$(color darker_background)"
replace_color "--pomo-bg-base" "$(color background)"
replace_color "--pomo-bg-elevated" "$(color lighter_background)"
replace_color "--pomo-accent" "$(color accent)"
replace_color "--pomo-text-main" "$(color foreground)"
replace_color "--pomo-text-muted" "$(color dark_foreground)"