{
  "bar": {
    "centerAnchor": "fuck-omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "fuck-omarchy.workspaces"
        },
        {
          "id": "skyymedia"
        }
      ],
      "center": [
        {
          "id": "fuck-omarchy.keyboard-layout"
        },
        {
          "format": "dddd ~ h:mm AP ~ d MMM",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "fuck-omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "skyyindicators",
          "items": [
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "skyypomoru"
        }
      ],
      "right": [
        {
          "id": "fuck-omarchy.tray"
        },
        {
          "id": "skyystats",
          "type": "command",
          "exec": "~/.config/fuck-omarchy/bar/scripts/skyystats",
          "interval": 1,
          "horizontalMargin": 5,
          "onClick": "fuck-omarchy-launch-or-focus-tui btop",
          "tooltip": "CPU / GPU / memory"
        },
        {
          "exec": "~/.config/fuck-omarchy/bar/scripts/autostart",
          "fontSize": 16,
          "horizontalMargin": 8.75,
          "id": "system.autostart",
          "interval": 1,
          "onClick": "skyytoggle-autostart",
          "tooltip": "Startup apps",
          "type": "command"
        },
        {
          "id": "fuck-omarchy.bluetooth"
        },
        {
          "id": "fuck-omarchy.network"
        },
        {
          "id": "fuck-omarchy.monitor"
        },
        {
          "id": "skyyaudio"
        },
        {
          "id": "fuck-omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "skyynotifications",
    "skyylock",
    "skyyidle"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "skyynotifications"
    },
    {
      "id": "skyylock"
    },
    {
      "id": "skyyidle"
    }
  ],
  "version": 1
}
