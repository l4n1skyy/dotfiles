TARGET_OS_NAME="OS"

ESP_PATH="/boot"

KERNEL_CMDLINE[default]+="cryptdevice=PARTUUID=7490455c-4a0f-491d-aa42-c0289959642d:root root=/dev/mapper/root zswap.enabled=0 rootflags=subvol=@ rw rootfstype=btrfs"
KERNEL_CMDLINE[default]+=" quiet splash loglevel=0 systemd.show_status=false rd.udev.log_level=0 vt.global_cursor_default=0"

ENABLE_UKI=yes
CUSTOM_UKI_NAME="arch"

ENABLE_LIMINE_FALLBACK=yes

# Find and add other bootloaders
FIND_BOOTLOADERS=yes


MAX_SNAPSHOT_ENTRIES=1

SNAPSHOT_FORMAT_CHOICE=5

BOOT_ORDER="linux-cachyos-bore, *, *fallback, Snapshots"
EXCLUDE_SNAPSHOT_ENTRIES="Windows*, windows*"
EXCLUDE_SNAPSHOT_TYPES="post"
