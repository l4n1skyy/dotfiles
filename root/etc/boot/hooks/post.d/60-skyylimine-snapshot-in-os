#!/usr/bin/env bash
# limine post-hook (after 40-skyylimine-menu-layout and 50-skyylimine-snapshot-latest, before
# config enrollment): move the flattened //snapshot-latest entry from the top-level /+Snapshots
# section to the end of /+OS and drop the Snapshots header, so the menu reads
#
#   /+OS  Arch Linux, Windows, snapshot-latest
#
# pre.d/20-skyylimine-snapshots-section moves it back out before the next limine tool run,
# because limine-snapper-sync writes its entries into the /Snapshots section.
# Left alone (with a warning) if the Snapshots section is not flattened yet.
# Usage: 60-skyylimine-snapshot-in-os [limine.conf]  (default: $ESP_PATH/limine.conf)

set -euo pipefail

conf="${1:-${ESP_PATH:-/boot}/limine.conf}"
[[ -f "$conf" ]] || exit 0
grep -q -E '^/\+?Snapshots[[:space:]]*$' "$conf" || exit 0
mid="$(cat /etc/machine-id 2>/dev/null || true)"

tmp="$(mktemp "$(dirname "$conf")/.limine.conf.XXXXXX")"
stale="$(mktemp)"
trap 'rm -f "$tmp" "$stale"' EXIT

rc=0
awk -v mid="$mid" -v stale="$stale" '
function trim(s) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s }
function secname(s) { sub(/^\/\+?/, "", s); return trim(s) }
function depth(s,   m) { match(s, /^[[:space:]]*\/+/); m = substr(s, RSTART, RLENGTH); gsub(/[^\/]/, "", m); return length(m) }
function entname(s) { s = trim(s); sub(/^\/+\+?/, "", s); return trim(s) }
{ L[NR] = $0 }
END {
    ns = 0
    for (i = 1; i <= NR; i++) if (L[i] ~ /^\/[^\/]/) { ns++; sstart[ns] = i }
    for (s = 1; s <= ns; s++) send[s] = (s < ns ? sstart[s + 1] - 1 : NR)
    hdr_end = (ns ? sstart[1] - 1 : NR)

    os = 0
    for (s = 1; s <= ns && !os; s++)
        for (i = sstart[s] + 1; i <= send[s] && L[i] !~ /^[[:space:]]*\/\//; i++)
            if (mid != "" && L[i] ~ ("^[[:space:]]*comment:[[:space:]]*machine-id=" mid)) os = s
    for (s = 1; s <= ns && !os; s++) if (secname(L[sstart[s]]) == "OS") os = s
    if (!os) { for (i = 1; i <= NR; i++) print L[i]; exit 2 }

    # The Snapshots section(s): only flat entries (//name, no deeper levels) get moved
    nsnap = 0
    for (s = 1; s <= ns; s++) {
        if (secname(L[sstart[s]]) != "Snapshots") continue
        issnap[s] = 1
        for (i = sstart[s] + 1; i <= send[s]; i++) {
            if (trim(L[i]) == "") continue
            if (L[i] ~ /^[[:space:]]*\/\// && depth(L[i]) != 2) { for (i = 1; i <= NR; i++) print L[i]; exit 3 }
            snap[++nsnap] = L[i]
        }
    }

    for (i = 1; i <= hdr_end; i++) print L[i]
    for (s = 1; s <= ns; s++) {
        if (issnap[s]) continue
        if (s != os) { for (i = sstart[s]; i <= send[s]; i++) print L[i]; continue }
        # A leftover //snapshot-latest in /+OS gives way to the fresh one
        insnap = 0
        for (i = sstart[s]; i <= send[s]; i++) {
            if (i > sstart[s] && L[i] ~ /^[[:space:]]*\/\// && depth(L[i]) == 2) insnap = (nsnap && entname(L[i]) == "snapshot-latest")
            if (insnap) print L[i] > stale; else print L[i]
        }
        for (i = 1; i <= nsnap; i++) print snap[i]
    }
}
' "$conf" > "$tmp" || rc=$?

case $rc in
0) ;;
2) exit 0 ;;  # no OS section: nothing to move into
3) echo "snapshot-in-os: /+Snapshots is not flattened, leaving $conf alone" >&2; exit 1 ;;
*) echo "snapshot-in-os: awk failed (exit $rc), leaving $conf alone" >&2; exit 1 ;;
esac

# Sanity: a pure move (same lines minus the Snapshots header and any replaced leftover entry)
if [[ ! -s "$tmp" ]] || grep -q -E '^/\+?Snapshots[[:space:]]*$' "$tmp" \
    || ! cmp -s <(grep -v -x -E '/\+?Snapshots[[:space:]]*' "$conf" | grep -v -x -E '[[:space:]]*' | sort) \
                <(cat "$tmp" "$stale" | grep -v -x -E '[[:space:]]*' | sort); then
    echo "snapshot-in-os: result failed sanity checks, leaving $conf alone" >&2
    exit 1
fi
if ! cmp -s "$tmp" "$conf"; then
    mv -f "$tmp" "$conf"
    sync -f "$conf" 2>/dev/null || sync
    echo "snapshot-in-os: moved snapshot-latest into /+OS in $conf"
fi
