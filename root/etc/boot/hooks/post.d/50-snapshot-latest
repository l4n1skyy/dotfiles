#!/usr/bin/env bash
# limine post-hook: collapse the entries limine-snapper-sync writes under /+Snapshots
# (OS > date > kernel) into one flat "//snapshot-latest" entry for the newest snapshot.
# Runs after every limine-snapper-sync / limine-entry-tool update, before config enrollment.
# limine-snapper-sync rebuilds its block from snapshots.json on the next run, so the kernel
# files it references stay tracked; this hook just flattens that block again.

set -euo pipefail

conf="${1:-${ESP_PATH:-/boot}/limine.conf}"
[[ -f "$conf" ]] || exit 0
# Nothing to do unless limine-snapper-sync has (re)written its block
grep -q '^[[:space:]]*### Auto-generated by limine-snapper-sync' "$conf" || exit 0

tmp="$(mktemp "$(dirname "$conf")/.limine.conf.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

awk '
function depth(s,   m) { match(s, /^[[:space:]]*\/+/); m = substr(s, RSTART, RLENGTH); gsub(/[^\/]/, "", m); return length(m) }
function name(s)       { sub(/^[[:space:]]*\/+\+?/, "", s); return s }
function emit_section(   i) {
    print header
    if (kernel_start) {
        print "  //snapshot-latest"
        if (snap_label != "") print "  comment: Snapshot " snap_label (snap_desc != "" ? " (" snap_desc ")" : "")
        for (i = kernel_start; i <= kernel_end; i++) {
            l = sec[i]; sub(/^[[:space:]]+/, "", l)
            if (l != "") print "  " l
        }
    }
}
{
    if (!in_snap && $0 ~ /^\/\+?Snapshots[[:space:]]*$/) { in_snap = 1; header = $0; n = 0; next }
    if (in_snap && $0 ~ /^\/[^\/]/) { emit_section(); in_snap = 0; done = 1 }
    if (!in_snap) { print; next }

    sec[++n] = $0
    if ($0 ~ /^[[:space:]]*\/+/) {
        d = depth($0); hdr[d] = name($0); hdr_line[d] = n
        if (kernel_start && !kernel_end) kernel_end = n - 1
        cur = d
        next
    }
    # First entry with a protocol line is the newest snapshot kernel
    if (!kernel_start && $0 ~ /^[[:space:]]*protocol:/ && cur >= 3) {
        kernel_start = hdr_line[cur] + 1
        snap_label = hdr[cur - 1]
        for (i = hdr_line[cur - 1] + 1; i < hdr_line[cur]; i++)
            if (sec[i] ~ /^[[:space:]]*comment:/) { snap_desc = sec[i]; sub(/^[[:space:]]*comment:[[:space:]]*/, "", snap_desc); break }
    }
}
END {
    if (in_snap) { if (kernel_start && !kernel_end) kernel_end = n; emit_section() }
}
' "$conf" > "$tmp"

# Everything outside the Snapshots section must come through byte-for-byte
outside() { awk '/^\/\+?Snapshots[[:space:]]*$/ {s = 1; next} s && /^\/[^\/]/ {s = 0} !s' "$1"; }
if ! cmp -s <(outside "$conf") <(outside "$tmp"); then
    echo "snapshot-latest: unexpected change outside /+Snapshots, leaving $conf alone" >&2
    exit 1
fi
if ! cmp -s "$tmp" "$conf"; then
    mv -f "$tmp" "$conf"
    sync -f "$conf" 2>/dev/null || sync
    echo "snapshot-latest: flattened snapshot entries in $conf"
fi
